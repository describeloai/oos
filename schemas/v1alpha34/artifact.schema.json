{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oos.dev/schemas/v1alpha34/artifact.schema.json",
  "title": "Artifact",
  "description": "El artefacto: un paquete de software (Maven, PyPI) traido de fuera, como contenido gobernado. El documento DECLARA —formato y coordenada—; sus versiones y ficheros son dato de la plataforma. Que la coordenada sea unica en el arbol (OOS2055) no lo dice este esquema.\n\nNormativo: spec/v1alpha34/01-artifact.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "oos.dev/v1alpha34" },
    "kind": { "const": "Artifact" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "namespace": { "$ref": "../v1alpha1/type/basic.schema.json#/$defs/identifier" },
        "schema": { "$ref": "../v1alpha1/type/basic.schema.json#/$defs/identifier" },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "coordinate"],
      "properties": {
        "owner": { "type": "string" },
        "format": { "enum": ["maven", "pypi"] },
        "coordinate": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "format": { "const": "maven" } } },
          "then": { "properties": { "coordinate": { "pattern": "^[A-Za-z0-9._-]+:[A-Za-z0-9._-]+$" } } }
        },
        {
          "if": { "properties": { "format": { "const": "pypi" } } },
          "then": { "properties": { "coordinate": { "pattern": "^([A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9._-]*[A-Za-z0-9])$" } } }
        }
      ]
    }
  }
}
